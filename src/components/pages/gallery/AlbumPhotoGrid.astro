---
import { Icon } from "astro-icon/components";
import PhotoCard from "@/components/pages/gallery/PhotoCard.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

interface Props {
	photos: string[];
	albumId: string;
	columnWidth: number;
}

const { photos, albumId, columnWidth } = Astro.props;
---

<album-photo-search class="block">
  <!-- 按图片名搜索 -->
  <div class="relative mb-4">
    <Icon
      name="material-symbols:search"
      class="absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400 dark:text-neutral-500 text-lg pointer-events-none"
    />
    <input
      type="text"
      data-search
      placeholder={i18n(I18nKey.searchPhotos)}
      aria-label={i18n(I18nKey.searchPhotos)}
      class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-(--line-divider) bg-transparent text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 dark:placeholder-neutral-500 focus:border-(--primary) focus:ring-1 focus:ring-(--primary) outline-none transition-all duration-200 text-sm"
    />
  </div>

  <!-- 瀑布流照片网格 -->
  <div
    class="gallery-masonry"
    style={`column-count: 2; column-gap: 0.75rem; --col-width: ${columnWidth}px;`}
  >
    {photos.map((photo) => (
      <PhotoCard src={photo} albumId={albumId} />
    ))}
  </div>

  <!-- 搜索无结果提示 -->
  <div
    data-photo-empty
    class="hidden flex-col items-center justify-center py-12 text-neutral-400 dark:text-neutral-500"
  >
    <Icon name="material-symbols:search-off-rounded" class="text-4xl mb-3" />
    <div class="text-sm">{i18n(I18nKey.searchNoResults)}</div>
  </div>
</album-photo-search>

<script>
  class AlbumPhotoSearch extends HTMLElement {
    private input: HTMLInputElement | null = null;
    private empty: HTMLElement | null = null;
    private cards: HTMLElement[] = [];

    connectedCallback() {
      if (this.dataset.bound === "true") return;
      this.dataset.bound = "true";

      this.input = this.querySelector<HTMLInputElement>("[data-search]");
      this.empty = this.querySelector<HTMLElement>("[data-photo-empty]");
      this.cards = Array.from(
        this.querySelectorAll<HTMLElement>(".gallery-photo-card"),
      );

      this.input?.addEventListener("input", () => this.applyFilter());
    }

    private applyFilter() {
      const keywords = (this.input?.value || "")
        .toLowerCase()
        .trim()
        .split(/\s+/)
        .filter(Boolean);

      let visible = 0;

      for (const card of this.cards) {
        const name = (card.dataset.name || "").toLowerCase();
        const match = keywords.every((keyword) => name.includes(keyword));

        card.style.display = match ? "" : "none";

        // 同步灯箱分组，避免翻页时出现被过滤掉的照片
        const link = card.querySelector<HTMLElement>(
          "[data-src][data-type='image']",
        );
        if (link) {
          if (match) {
            link.setAttribute(
              "data-fancybox",
              card.dataset.galleryGroup || "",
            );
          } else {
            link.removeAttribute("data-fancybox");
          }
        }

        if (match) visible++;
      }

      if (this.empty) {
        const showEmpty = keywords.length > 0 && visible === 0;
        this.empty.classList.toggle("hidden", !showEmpty);
        this.empty.classList.toggle("flex", showEmpty);
      }
    }
  }

  if (!customElements.get("album-photo-search")) {
    customElements.define("album-photo-search", AlbumPhotoSearch);
  }
</script>
